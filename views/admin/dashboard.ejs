<%- include('../partials/admin-header') %>

<div class="page-title">
  <h1><i class="fas fa-tachometer-alt"></i> Dashboard</h1>
  <p>Welcome back, <%= currentAdmin.name %>!</p>
</div>

<!-- STATS GRID -->
<div class="stats-grid">
  <div class="stat-card stat-blue">
    <i class="fas fa-calendar-check"></i>
    <div><span><%= stats.total_bookings || 0 %></span><p>Total Bookings</p></div>
  </div>
  <div class="stat-card stat-yellow">
    <i class="fas fa-hourglass-half"></i>
    <div><span><%= stats.pending_bookings || 0 %></span><p>Pending</p></div>
  </div>
  <div class="stat-card stat-green">
    <i class="fas fa-check-circle"></i>
    <div><span><%= stats.approved_bookings || 0 %></span><p>Approved</p></div>
  </div>
  <div class="stat-card stat-red">
    <i class="fas fa-times-circle"></i>
    <div><span><%= stats.rejected_bookings || 0 %></span><p>Rejected</p></div>
  </div>
  <div class="stat-card stat-purple">
    <i class="fas fa-envelope"></i>
    <div><span><%= stats.total_queries || 0 %></span><p>Total Queries</p></div>
  </div>
  <div class="stat-card stat-orange">
    <i class="fas fa-bell"></i>
    <div><span><%= stats.unread_queries || 0 %></span><p>Unread Queries</p></div>
  </div>
  <div class="stat-card stat-teal">
    <i class="fas fa-concierge-bell"></i>
    <div><span><%= stats.total_services || 0 %></span><p>Services Listed</p></div>
  </div>
  <div class="stat-card stat-indigo">
    <i class="fas fa-users"></i>
    <div><span><%= stats.total_users || 0 %></span><p>Registered Users</p></div>
  </div>
</div>

<!-- RECENT DATA -->
<div class="dashboard-tables">
  <div class="admin-table-card">
    <div class="table-card-header">
      <h3><i class="fas fa-clock"></i> Recent Bookings</h3>
      <a href="/admin/bookings" class="btn btn-sm btn-outline">View All</a>
    </div>
    <% if (recentBookings.length === 0) { %>
    <div class="empty-state"><i class="fas fa-calendar"></i><p>No bookings yet</p></div>
    <% } else { %>
    <div class="table-responsive">
      <table class="admin-table">
        <thead><tr><th>Booking #</th><th>Name</th><th>From → To</th><th>Date</th><th>Status</th><th>Action</th></tr></thead>
        <tbody>
          <% recentBookings.forEach(function(b) { %>
          <tr>
            <td><%= b.booking_number %></td>
            <td><%= b.guest_name %></td>
            <td><%= b.from_city %> → <%= b.to_city %></td>
            <td><%= new Date(b.move_date).toLocaleDateString('en-IN') %></td>
            <td><span class="status-badge status-<%= b.status %>"><%= b.status %></span></td>
            <td><a href="/admin/bookings/<%= b.id %>" class="btn btn-xs btn-outline">View</a></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <div class="admin-table-card">
    <div class="table-card-header">
      <h3><i class="fas fa-envelope"></i> Recent Queries</h3>
      <a href="/admin/queries" class="btn btn-sm btn-outline">View All</a>
    </div>
    <% if (recentQueries.length === 0) { %>
    <div class="empty-state"><i class="fas fa-inbox"></i><p>No queries yet</p></div>
    <% } else { %>
    <div class="table-responsive">
      <table class="admin-table">
        <thead><tr><th>Name</th><th>Subject</th><th>Date</th><th>Status</th><th>Action</th></tr></thead>
        <tbody>
          <% recentQueries.forEach(function(q) { %>
          <tr class="<%= !q.is_read ? 'unread-row' : '' %>">
            <td><%= q.name %></td>
            <td><%= (q.subject || 'No Subject').substring(0,30) %>...</td>
            <td><%= new Date(q.created_at).toLocaleDateString('en-IN') %></td>
            <td><span class="badge <%= q.is_read ? 'badge-success' : 'badge-warning' %>"><%= q.is_read ? 'Read' : 'Unread' %></span></td>
            <td><a href="/admin/queries/<%= q.id %>" class="btn btn-xs btn-outline">View</a></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/admin-footer') %>
