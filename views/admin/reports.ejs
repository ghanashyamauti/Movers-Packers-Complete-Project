<%- include('../partials/admin-header') %>
<div class="page-title"><h1><i class="fas fa-chart-bar"></i> Reports</h1></div>
<div class="admin-form-card">
  <form action="/admin/reports" method="GET">
    <div class="form-row">
      <div class="form-group"><label>From Date</label><input type="date" name="from_date" class="form-control" value="<%= from_date %>"></div>
      <div class="form-group"><label>To Date</label><input type="date" name="to_date" class="form-control" value="<%= to_date %>"></div>
      <div class="form-group">
        <label>Report Type</label>
        <select name="type" class="form-control">
          <option value="">Both</option>
          <option value="bookings" <%= type==='bookings' ? 'selected' : '' %>>Bookings Only</option>
          <option value="queries" <%= type==='queries' ? 'selected' : '' %>>Queries Only</option>
        </select>
      </div>
      <div class="form-group" style="display:flex;align-items:flex-end">
        <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-filter"></i> Generate Report</button>
      </div>
    </div>
  </form>
</div>

<% if (from_date && to_date) { %>
<div class="report-summary">
  <p>Report from <strong><%= from_date %></strong> to <strong><%= to_date %></strong></p>
  <div class="report-stats">
    <span class="report-stat"><i class="fas fa-calendar-check"></i> <strong><%= bookings.length %></strong> Bookings</span>
    <span class="report-stat"><i class="fas fa-envelope"></i> <strong><%= queries.length %></strong> Queries</span>
  </div>
</div>

<% if (!type || type === 'bookings') { %>
<div class="admin-table-card">
  <div class="table-card-header"><h3><i class="fas fa-calendar-check"></i> Bookings (<%= bookings.length %>)</h3></div>
  <% if (bookings.length === 0) { %>
  <div class="empty-state"><i class="fas fa-calendar"></i><p>No bookings in this period</p></div>
  <% } else { %>
  <div class="table-responsive">
    <table class="admin-table">
      <thead><tr><th>Booking #</th><th>Customer</th><th>Service</th><th>From → To</th><th>Move Date</th><th>Status</th><th>Submitted</th></tr></thead>
      <tbody>
        <% bookings.forEach(function(b) { %>
        <tr>
          <td><%= b.booking_number %></td>
          <td><%= b.guest_name %></td>
          <td><%= b.service_name %></td>
          <td><%= b.from_city %> → <%= b.to_city %></td>
          <td><%= new Date(b.move_date).toLocaleDateString('en-IN') %></td>
          <td><span class="status-badge status-<%= b.status %>"><%= b.status %></span></td>
          <td><%= new Date(b.created_at).toLocaleDateString('en-IN') %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
<% } %>

<% if (!type || type === 'queries') { %>
<div class="admin-table-card">
  <div class="table-card-header"><h3><i class="fas fa-envelope"></i> Queries (<%= queries.length %>)</h3></div>
  <% if (queries.length === 0) { %>
  <div class="empty-state"><i class="fas fa-inbox"></i><p>No queries in this period</p></div>
  <% } else { %>
  <div class="table-responsive">
    <table class="admin-table">
      <thead><tr><th>Name</th><th>Email</th><th>Subject</th><th>Status</th><th>Date</th></tr></thead>
      <tbody>
        <% queries.forEach(function(q) { %>
        <tr>
          <td><%= q.name %></td>
          <td><%= q.email %></td>
          <td><%= q.subject || 'No Subject' %></td>
          <td><span class="badge <%= q.is_read ? 'badge-success' : 'badge-warning' %>"><%= q.is_read ? 'Read' : 'Unread' %></span></td>
          <td><%= new Date(q.created_at).toLocaleDateString('en-IN') %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
<% } %>
<% } %>

<%- include('../partials/admin-footer') %>
