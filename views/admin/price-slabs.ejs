<%- include('../partials/admin-header') %>

<div class="page-title">
  <h1><i class="fas fa-route"></i> Manage Distance Slabs</h1>
  <a href="/admin/price-items" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div class="admin-table-card">
  <div class="table-card-header">
    <h3><i class="fas fa-info-circle"></i> How pricing works</h3>
  </div>
  <div style="padding:15px 22px;color:#666;font-size:0.9rem;background:#fffbf0;border-bottom:1px solid #e2e8f0">
    <strong>Formula: Estimate = Base Charge + (Total Weight × Price Per KG) + Item Handling Charges</strong><br>
    Example: 150km move, 200kg items → ₹1500 + (200 × ₹4) + handling = ₹2300 + handling
  </div>
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr><th>Label</th><th>Min KM</th><th>Max KM</th><th>Base Charge (₹)</th><th>Price Per KG (₹)</th><th>Status</th><th>Action</th></tr>
      </thead>
      <tbody>
        <% slabs.forEach(function(s) { %>
        <tr>
          <td><strong><%= s.label %></strong></td>
          <td><%= s.min_km %> km</td>
          <td><%= s.max_km ? s.max_km + ' km' : 'No limit' %></td>
          <td>
            <form action="/admin/price-slabs/update/<%= s.id %>" method="POST" style="display:contents">
              <input type="number" name="base_charge" value="<%= s.base_charge %>" class="form-control" style="width:100px;display:inline-block" min="0">
          </td>
          <td>
              <input type="number" name="price_per_kg" value="<%= s.price_per_kg %>" class="form-control" style="width:80px;display:inline-block" min="0" step="0.5">
          </td>
          <td>
              <select name="is_active" class="form-control" style="width:90px;display:inline-block">
                <option value="true" <%= s.is_active ? 'selected' : '' %>>Active</option>
                <option value="false" <%= !s.is_active ? 'selected' : '' %>>Off</option>
              </select>
          </td>
          <td>
              <button type="submit" class="btn btn-xs btn-primary"><i class="fas fa-save"></i> Save</button>
            </form>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/admin-footer') %>