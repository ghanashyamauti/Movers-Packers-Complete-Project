<%- include('../partials/admin-header') %>
<div class="page-title"><h1><i class="fas fa-user-cog"></i> Admin Profile</h1></div>
<div class="admin-form-card" style="max-width:500px">
  <form action="/admin/profile" method="POST">
    <div class="form-group"><label>Full Name</label><input type="text" name="name" class="form-control" value="<%= admin.name %>" required></div>
    <div class="form-group"><label>Email (cannot change)</label><input type="email" class="form-control" value="<%= admin.email %>" disabled></div>
    <div class="form-group"><label>Phone</label><input type="text" name="phone" class="form-control" value="<%= admin.phone || '' %>"></div>
    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Profile</button>
  </form>
</div>
<%- include('../partials/admin-footer') %>
