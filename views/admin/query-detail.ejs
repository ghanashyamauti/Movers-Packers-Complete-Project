<%- include('../partials/admin-header') %>

<div class="page-title">
  <h1><i class="fas fa-envelope-open"></i> Query Details</h1>
  <a href="/admin/queries" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div class="booking-detail-layout">
  <div class="booking-detail-card">
    <div class="detail-sections">
      <div class="detail-section">
        <h4><i class="fas fa-user"></i> Sender</h4>
        <p><strong>Name:</strong> <%= query.name %></p>
        <p><strong>Email:</strong> <a href="mailto:<%= query.email %>"><%= query.email %></a></p>
        <p><strong>Phone:</strong> <%= query.phone || 'N/A' %></p>
        <p><strong>Date:</strong> <%= new Date(query.created_at).toLocaleString('en-IN') %></p>
      </div>
      <div class="detail-section">
        <h4><i class="fas fa-tag"></i> Subject</h4>
        <p><%= query.subject || 'No Subject' %></p>
      </div>
      <div class="detail-section full-width">
        <h4><i class="fas fa-comment"></i> Message</h4>
        <div class="message-box"><%= query.message %></div>
      </div>
      <% if (query.admin_reply) { %>
      <div class="detail-section full-width">
        <h4><i class="fas fa-reply"></i> Admin Reply (saved)</h4>
        <div class="message-box reply-box"><%= query.admin_reply %></div>
        <small>Replied: <%= query.replied_at ? new Date(query.replied_at).toLocaleString('en-IN') : '' %></small>
      </div>
      <% } %>
    </div>
  </div>

  <div class="admin-action-card">
    <h3><i class="fas fa-reply"></i> Save Reply / Notes</h3>
    <form action="/admin/queries/<%= query.id %>/reply" method="POST">
      <div class="form-group">
        <label>Reply / Notes</label>
        <textarea name="reply" rows="8" class="form-control" placeholder="Type your reply or notes here..."><%= query.admin_reply || '' %></textarea>
      </div>
      <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-save"></i> Save Reply</button>
    </form>
  </div>
</div>

<%- include('../partials/admin-footer') %>
