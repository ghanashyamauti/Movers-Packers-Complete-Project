<%- include('../partials/admin-header') %>

<div class="page-title">
  <h1><i class="fas fa-calendar-check"></i> Manage Bookings</h1>
</div>

<div class="filter-bar">
  <a href="/admin/bookings" class="btn btn-sm <%= filter==='all' ? 'btn-primary' : 'btn-outline' %>">All</a>
  <a href="/admin/bookings?status=pending" class="btn btn-sm <%= filter==='pending' ? 'btn-primary' : 'btn-outline' %>">Pending</a>
  <a href="/admin/bookings?status=approved" class="btn btn-sm <%= filter==='approved' ? 'btn-primary' : 'btn-outline' %>">Approved</a>
  <a href="/admin/bookings?status=rejected" class="btn btn-sm <%= filter==='rejected' ? 'btn-primary' : 'btn-outline' %>">Rejected</a>
  <a href="/admin/bookings?status=completed" class="btn btn-sm <%= filter==='completed' ? 'btn-primary' : 'btn-outline' %>">Completed</a>
</div>

<div class="admin-table-card">
  <% if (bookings.length === 0) { %>
  <div class="empty-state"><i class="fas fa-calendar-times"></i><p>No bookings found</p></div>
  <% } else { %>
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr><th>Booking #</th><th>Customer</th><th>Phone</th><th>Service</th><th>From → To</th><th>Move Date</th><th>Status</th><th>Action</th></tr>
      </thead>
      <tbody>
        <% bookings.forEach(function(b) { %>
        <tr>
          <td><strong><%= b.booking_number %></strong></td>
          <td><%= b.guest_name %><br><small><%= b.guest_email %></small></td>
          <td><%= b.guest_phone %></td>
          <td><%= b.service_name || 'General' %></td>
          <td><%= b.from_city %> → <%= b.to_city %></td>
          <td><%= new Date(b.move_date).toLocaleDateString('en-IN') %></td>
          <td><span class="status-badge status-<%= b.status %>"><%= b.status %></span></td>
          <td><a href="/admin/bookings/<%= b.id %>" class="btn btn-xs btn-outline"><i class="fas fa-eye"></i> View</a></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<%- include('../partials/admin-footer') %>
