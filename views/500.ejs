<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Server Error - SwiftMove</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'DM Sans', sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; background: #f0f4f8; text-align: center; }
    h1 { font-size: 6rem; color: #e74c3c; margin: 0; }
    a { color: #f6921e; font-weight: 600; }
  </style>
</head>
<body>
  <div>
    <h1>500</h1>
    <h2>Something went wrong</h2>
    <p><%= typeof error !== 'undefined' ? error : 'Internal server error' %></p>
    <a href="/">Go Home</a>
  </div>
</body>
</html>
