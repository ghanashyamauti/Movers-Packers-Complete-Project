      <h2>Meet the Team</h2>
      <p>Our dedicated team of professionals ensures every move is handled with care and precision.</p>
    </div>
    <div class="team-grid">
      <!-- TEAM MEMBER PHOTOS: Upload photos to /public/images/team/ -->
      <div class="team-card">
        <div class="team-photo" style="width:200px;height:200px;border-radius:50%;overflow:hidden;margin:0 auto 16px;">
  <img src="/images/team/team-1.jpg" alt="Kalyani Pimpale" style="width:100%;height:100%;object-fit:cover;object-position:center top;">
</div>
        <h4>Kalyani Pimpale</h4>
        <p>Founder & CEO</p>
        <div class="team-social">
          <a href="#"><i class="fab fa-linkedin"></i></a>
        </div>
      </div>
      <div class="team-card">
        <div class="team-photo" style="width:200px;height:200px;border-radius:50%;overflow:hidden;margin:0 auto 16px;">
  <img src="/images/team/team-2.jpg" alt="Ghanashyam Auti" style="width:100%;height:100%;object-fit:cover;object-position:center top;">
</div>
        <h4>Ghanashyam Auti</h4>
        <p>Operations Head</p>
        <div class="team-social">
          <a href="#"><i class="fab fa-linkedin"></i></a>
        </div>
      </div>
      <div class="team-card">
        <div class="team-photo" style="width:200px;height:200px;border-radius:50%;overflow:hidden;margin:0 auto 16px;">
  <img src="/images/team/team-3.jpg" alt="Sakshi Darekar" style="width:100%;height:100%;object-fit:cover;object-position:center top;">
</div>
        <h4>Sakshi Darekar</h4>
        <p>Logistics Manager</p>
        <div class="team-social">
          <a href="#"><i class="fab fa-linkedin"></i></a>
        </div>
      </div>
      <div class="team-card">
        <div class="team-photo" style="width:200px;height:200px;border-radius:50%;overflow:hidden;margin:0 auto 16px;">
  <img src="/images/team/team-4.jpg" alt="Monika Mhaske" style="width:100%;height:100%;object-fit:cover;object-position:center top;">
</div>
        <h4>Monika Mhaske</h4>
        <p>Customer Relations</p>
        <div class="team-social">
          <a href="#"><i class="fab fa-linkedin"></i></a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MILESTONES -->
<section class="section milestones">
  <div class="container">
    <div class="milestones-grid">
      <div class="milestone"><span>50,000+</span><p>Happy Clients</p></div>
      <div class="milestone"><span>500+</span><p>Cities Covered</p></div>
      <div class="milestone"><span>200+</span><p>Trained Staff</p></div>
      <div class="milestone"><span>5+</span><p>Years Experience</p></div>
    </div>
  </div>
</section>

