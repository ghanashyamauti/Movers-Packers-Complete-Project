<%- include('../partials/header') %>
<section class="page-banner"><div class="container"><h1>Change Password</h1></div></section>
<section class="section user-dashboard">
  <div class="container">
    <div class="user-layout">
      <aside class="user-sidebar">
        <div class="user-sidebar-profile"><div class="user-avatar"><i class="fas fa-user-circle"></i></div><h4><%= currentUser.name %></h4></div>
        <nav class="user-nav">
          <a href="/user/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
          <a href="/request-quote"><i class="fas fa-plus-circle"></i> New Booking</a>
          <a href="/user/my-requests"><i class="fas fa-list-alt"></i> My Requests</a>
          <a href="/user/my-account"><i class="fas fa-user"></i> My Account</a>
          <a href="/user/change-password" class="active"><i class="fas fa-key"></i> Change Password</a>
          <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </nav>
      </aside>
      <div class="user-content">
        <div class="content-card" style="max-width:500px">
          <div class="card-header"><h3><i class="fas fa-key"></i> Change Password</h3></div>
          <form action="/user/change-password" method="POST">
            <div class="form-group"><label>Current Password</label><input type="password" name="current_password" class="form-control" required></div>
            <div class="form-group"><label>New Password</label><input type="password" name="new_password" class="form-control" required minlength="6"></div>
            <div class="form-group"><label>Confirm New Password</label><input type="password" name="confirm_password" class="form-control" required></div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-lock"></i> Update Password</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
